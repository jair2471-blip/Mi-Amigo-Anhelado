---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Biblia 365 - Misión Marte">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" is:inline></script>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400;1,700&family=Crimson+Text:ital,wght@0,400;0,600;1,400;1,600&family=Bebas+Neue&family=IM+Fell+English:ital@0;1&family=Cormorant+Garamond:ital,wght@0,300;0,600;1,300;1,600&display=swap" rel="stylesheet">

  <style is:inline>
    :root { 
      --primary: #1a4d2e; --accent: #d4a574; --bg: #faf8f5; --text: #1a202c; 
      --surface: rgba(255, 255, 255, 0.9); --card-bg: #ffffff; --f-size: 21px;
    }
    body.dark-mode { 
      --bg: #0d1110; --text: #e2e8f0; --surface: rgba(26, 31, 30, 0.9); 
      --card-bg: #161b1a; --primary: #52b788; 
    }
    html, body {
      margin: 0; padding: 0; width: 100%; min-height: 100vh;
      display: flex; flex-direction: column; align-items: center;
      background-color: var(--bg); color: var(--text);
      transition: background 0.3s ease; font-family: 'Crimson Text', serif;
      scroll-behavior: smooth;
    }
    .main-container { width: 100%; max-width: 750px; padding: 20px; box-sizing: border-box; min-height: 100vh; }

    .progress-container { position: sticky; top: 0; z-index: 1000; width: 100%; background: var(--bg); padding: 10px 0; }
    .progress-bar { height: 6px; background: #e2e8f0; border-radius: 10px; overflow: hidden; }
    #progreso-valor { height: 100%; background: var(--accent); width: 0%; transition: width 0.4s; }

    .toolbar { 
      display: flex; justify-content: space-between; align-items: center; 
      background: var(--surface); padding: 12px 20px; border-radius: 50px; 
      margin: 10px 0 30px; border: 1px solid rgba(0,0,0,0.1); backdrop-filter: blur(10px);
    }
    .btn-top { background: var(--primary); color: white; border: none; padding: 10px 18px; border-radius: 20px; cursor: pointer; font-weight: bold; }

    .acordeon-item { background: var(--card-bg); border-radius: 24px; margin-bottom: 25px; border: 1px solid rgba(0,0,0,0.05); overflow: hidden; transition: 0.3s; }
    .acordeon-item.active { border-color: var(--accent); }
    .acordeon-header { padding: 20px 25px; cursor: pointer; display: flex; justify-content: space-between; align-items: center; }
    .acordeon-header h2 { margin: 0; font-family: 'Playfair Display'; color: var(--primary); font-size: 1.5rem; }
    .acordeon-content { max-height: 0; overflow: hidden; transition: max-height 0.5s ease; padding: 0 30px; }
    .acordeon-item.active .acordeon-content { max-height: 20000px; padding: 10px 30px 40px; }

    .v-txt { font-size: var(--f-size); line-height: 1.7; margin-bottom: 8px; display: block; padding: 10px; border-radius: 12px; cursor: pointer; }
    .v-txt.read { opacity: 0.5; }
    .v-num { color: var(--accent); font-weight: bold; margin-right: 10px; }

    #menuAcciones { 
      position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); 
      background: var(--primary); padding: 12px 25px; border-radius: 50px; 
      display: none; gap: 15px; z-index: 2000; box-shadow: 0 15px 35px rgba(0,0,0,0.3);
    }
    .btn-tool { background: none; border: none; color: white; cursor: pointer; display: flex; flex-direction: column; align-items: center; font-size: 0.7rem; gap: 4px; }

    /* ===== MODAL SELECTOR DE PLANTILLA ===== */
    #modalPlantilla {
      position: fixed; inset: 0; display: none; z-index: 3500;
      background: rgba(0,0,0,0.92); backdrop-filter: blur(16px);
      flex-direction: column; align-items: center; justify-content: center; padding: 20px;
    }
    #modalPlantilla.visible { display: flex; }
    .plantilla-header { color: white; text-align: center; margin-bottom: 24px; }
    .plantilla-header h3 { font-family: 'Playfair Display'; font-size: 1.8rem; margin: 0; color: #d4a574; }
    .plantilla-header p { color: rgba(255,255,255,0.6); margin: 6px 0 0; font-size: 0.9rem; letter-spacing: 2px; text-transform: uppercase; }
    
    .plantillas-grid {
      display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px;
      width: 100%; max-width: 700px;
    }
    @media (max-width: 600px) { .plantillas-grid { grid-template-columns: repeat(3, 1fr); } }
    
    .plantilla-card {
      aspect-ratio: 1; border-radius: 16px; cursor: pointer; overflow: hidden;
      border: 3px solid transparent; transition: all 0.25s; position: relative;
      display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .plantilla-card:hover { transform: scale(1.06); border-color: #d4a574; }
    .plantilla-card.seleccionada { border-color: #d4a574; box-shadow: 0 0 20px rgba(212,165,116,0.6); }
    .plantilla-card span { font-size: 0.65rem; font-weight: bold; letter-spacing: 1px; text-align: center; padding: 0 4px; }
    
    /* Preview cards */
    .prev-gloria { background: linear-gradient(135deg, #fdf6e3 0%, #f5e6c8 100%); border: 2px solid #c9973d; }
    .prev-gloria span { color: #7a4f1a; }
    .prev-cosmos { background: linear-gradient(160deg, #020818 0%, #0d1b4b 50%, #1a0a2e 100%); }
    .prev-cosmos span { color: #f0c060; }
    .prev-editorial { background: #f5f0e8; }
    .prev-editorial span { color: #1a1a1a; }
    .prev-llama { background: linear-gradient(160deg, #1a0500 0%, #7c1d06 40%, #c45a00 80%, #e8a020 100%); }
    .prev-llama span { color: #fde8c0; }
    .prev-jardin { background: linear-gradient(160deg, #0a1f10 0%, #183d22 50%, #0e2918 100%); }
    .prev-jardin span { color: #90d4a0; }

    .prev-icon { font-size: 1.8rem; margin-bottom: 4px; }
    
    .formato-selector {
      display: flex; gap: 12px; margin-top: 20px;
    }
    .btn-formato {
      flex: 1; padding: 14px 20px; border-radius: 50px; border: 2px solid rgba(255,255,255,0.3);
      background: transparent; color: white; cursor: pointer; font-family: 'Playfair Display'; font-size: 1rem;
      transition: all 0.2s; max-width: 160px;
    }
    .btn-formato:hover { background: #d4a574; border-color: #d4a574; color: #1a0a00; }
    .btn-cerrar-plantilla {
      margin-top: 16px; background: transparent; border: 1px solid rgba(255,255,255,0.2);
      color: rgba(255,255,255,0.5); padding: 8px 24px; border-radius: 30px; cursor: pointer; font-size: 0.85rem;
    }

    /* ===== MODALES ===== */
    #modalBib, #modalExito { position: fixed; inset: 0; display: none; place-items: center; z-index: 3000; padding: 20px; backdrop-filter: blur(10px); }
    #modalBib { background: rgba(0,0,0,0.85); }
    #modalExito { background: rgba(26, 77, 46, 0.95); }

    .modal-box { background: var(--bg); padding: 30px; border-radius: 30px; width: 100%; max-width: 600px; max-height: 80vh; overflow-y: auto; }
    .box-exito { background: white; padding: 40px; border-radius: 40px; text-align: center; max-width: 400px; width: 90%; border: 4px solid var(--accent); }

    .grid-libros, .grid-caps { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 10px; margin-top: 20px; }
    .btn-lib { background: var(--card-bg); border: 1px solid rgba(0,0,0,0.1); padding: 12px; border-radius: 15px; cursor: pointer; color: var(--text); font-weight: 600; }

    /* ===== CANVAS DE RENDER ===== */
    #canvas-render { 
      position: fixed; top: 0; left: 0;
      visibility: hidden; pointer-events: none;
      box-sizing: border-box;
      display: flex; justify-content: center; align-items: center;
      z-index: -1;
    }
    .formato-feed { width: 1080px; height: 1080px; }
    .formato-historia { width: 1080px; height: 1920px; }

    /* === PLANTILLA 1: GLORIA === */
    #canvas-render.tema-gloria {
      background: #fdf6e3;
    }
    #canvas-render.tema-gloria .render-inner {
      width: 100%; height: 100%; display: flex; flex-direction: column;
      align-items: center; justify-content: center; padding: 80px; box-sizing: border-box;
      position: relative;
    }
    #canvas-render.tema-gloria .render-inner::before {
      content: ''; position: absolute; inset: 40px;
      border: 2px solid #c9973d; pointer-events: none;
    }
    #canvas-render.tema-gloria .render-inner::after {
      content: ''; position: absolute; inset: 50px;
      border: 1px solid rgba(201,151,61,0.4); pointer-events: none;
    }
    #canvas-render.tema-gloria .corner {
      position: absolute; width: 60px; height: 60px; border-color: #c9973d;
    }
    #canvas-render.tema-gloria .corner-tl { top: 30px; left: 30px; border-top: 4px solid; border-left: 4px solid; }
    #canvas-render.tema-gloria .corner-tr { top: 30px; right: 30px; border-top: 4px solid; border-right: 4px solid; }
    #canvas-render.tema-gloria .corner-bl { bottom: 30px; left: 30px; border-bottom: 4px solid; border-left: 4px solid; }
    #canvas-render.tema-gloria .corner-br { bottom: 30px; right: 30px; border-bottom: 4px solid; border-right: 4px solid; }
    #canvas-render.tema-gloria .render-marca { font-family: 'Playfair Display', serif; font-size: 22px; color: #c9973d; letter-spacing: 8px; text-transform: uppercase; margin-bottom: 40px; }
    #canvas-render.tema-gloria .render-comilla { font-family: 'Playfair Display', serif; font-size: 180px; color: #c9973d; line-height: 0.5; margin-bottom: 20px; }
    #canvas-render.tema-gloria .render-texto { font-family: 'IM Fell English', serif; font-size: 58px; color: #3d2008; font-style: italic; line-height: 1.35; text-align: center; margin: 0; }
    #canvas-render.tema-gloria .render-linea { width: 120px; height: 3px; background: linear-gradient(90deg, transparent, #c9973d, transparent); margin: 40px auto; }
    #canvas-render.tema-gloria .render-ref { font-family: 'Playfair Display', serif; font-size: 28px; color: #c9973d; letter-spacing: 4px; text-transform: uppercase; }

    /* === PLANTILLA 2: COSMOS === */
    #canvas-render.tema-cosmos {
      background: #020818;
    }
    #canvas-render.tema-cosmos .render-inner {
      width: 100%; height: 100%; display: flex; flex-direction: column;
      align-items: center; justify-content: center; padding: 80px; box-sizing: border-box;
      position: relative; overflow: hidden;
    }
    #canvas-render.tema-cosmos .estrellas {
      position: absolute; inset: 0; 
      background-image: 
        radial-gradient(1px 1px at 10% 15%, rgba(255,255,255,0.8) 0%, transparent 100%),
        radial-gradient(1px 1px at 25% 40%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(2px 2px at 40% 10%, rgba(255,255,255,0.9) 0%, transparent 100%),
        radial-gradient(1px 1px at 60% 30%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 75% 5%, rgba(255,255,255,0.8) 0%, transparent 100%),
        radial-gradient(2px 2px at 85% 20%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 15% 60%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 50% 70%, rgba(255,255,255,0.8) 0%, transparent 100%),
        radial-gradient(2px 2px at 70% 80%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 90% 65%, rgba(255,255,255,0.5) 0%, transparent 100%),
        radial-gradient(1px 1px at 30% 85%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(1px 1px at 5% 90%, rgba(255,255,255,0.4) 0%, transparent 100%),
        radial-gradient(2px 2px at 95% 45%, rgba(255,255,255,0.7) 0%, transparent 100%),
        radial-gradient(1px 1px at 45% 50%, rgba(255,255,255,0.3) 0%, transparent 100%),
        radial-gradient(1px 1px at 80% 55%, rgba(255,255,255,0.6) 0%, transparent 100%),
        radial-gradient(3px 3px at 20% 25%, rgba(240,200,100,0.7) 0%, transparent 100%),
        radial-gradient(3px 3px at 65% 75%, rgba(180,160,255,0.5) 0%, transparent 100%);
    }
    #canvas-render.tema-cosmos .nebula {
      position: absolute; inset: 0;
      background: 
        radial-gradient(ellipse 60% 40% at 20% 30%, rgba(30,10,80,0.7) 0%, transparent 70%),
        radial-gradient(ellipse 50% 60% at 80% 70%, rgba(10,40,80,0.5) 0%, transparent 70%),
        radial-gradient(ellipse 40% 50% at 50% 50%, rgba(60,10,30,0.3) 0%, transparent 70%);
    }
    #canvas-render.tema-cosmos .render-marca { font-family: 'Cormorant Garamond', serif; font-size: 20px; color: rgba(240,200,100,0.7); letter-spacing: 10px; text-transform: uppercase; margin-bottom: 50px; position: relative; z-index: 1; }
    #canvas-render.tema-cosmos .render-comilla { font-family: 'Cormorant Garamond', serif; font-size: 200px; color: rgba(240,200,100,0.3); line-height: 0.4; margin-bottom: 30px; position: relative; z-index: 1; }
    #canvas-render.tema-cosmos .render-texto { font-family: 'Cormorant Garamond', serif; font-size: 60px; color: #f0e8d0; font-style: italic; font-weight: 300; line-height: 1.3; text-align: center; margin: 0; position: relative; z-index: 1; text-shadow: 0 0 40px rgba(240,200,100,0.3); }
    #canvas-render.tema-cosmos .render-linea { width: 200px; height: 1px; background: linear-gradient(90deg, transparent, rgba(240,200,100,0.8), transparent); margin: 45px auto; position: relative; z-index: 1; }
    #canvas-render.tema-cosmos .render-ref { font-family: 'Bebas Neue', sans-serif; font-size: 32px; color: #f0c060; letter-spacing: 8px; position: relative; z-index: 1; }
    #canvas-render.tema-cosmos .render-circulo {
      position: absolute; width: 700px; height: 700px; border-radius: 50%;
      border: 1px solid rgba(240,200,100,0.1);
      box-shadow: 0 0 0 40px rgba(240,200,100,0.02), 0 0 0 80px rgba(240,200,100,0.01);
      z-index: 0;
    }

    /* === PLANTILLA 3: EDITORIAL === */
    #canvas-render.tema-editorial {
      background: #f5f0e8;
    }
    #canvas-render.tema-editorial .render-inner {
      width: 100%; height: 100%; display: flex; flex-direction: column;
      align-items: flex-start; justify-content: center; padding: 100px; box-sizing: border-box;
      position: relative;
    }
    #canvas-render.tema-editorial .render-linea-top {
      position: absolute; top: 0; left: 0; right: 0; height: 20px; background: #1a1a1a;
    }
    #canvas-render.tema-editorial .render-linea-bottom {
      position: absolute; bottom: 0; left: 0; right: 0; height: 8px; background: #c9973d;
    }
    #canvas-render.tema-editorial .render-marca { font-family: 'Bebas Neue', sans-serif; font-size: 20px; color: #1a1a1a; letter-spacing: 12px; text-transform: uppercase; margin-bottom: 30px; opacity: 0.5; }
    #canvas-render.tema-editorial .render-numero { font-family: 'Bebas Neue', sans-serif; font-size: 300px; color: rgba(0,0,0,0.06); line-height: 0.8; position: absolute; right: 60px; top: 50%; transform: translateY(-50%); }
    #canvas-render.tema-editorial .render-texto { font-family: 'Playfair Display', serif; font-size: 72px; color: #1a1a1a; font-style: italic; line-height: 1.2; text-align: left; margin: 0; position: relative; z-index: 1; max-width: 800px; }
    #canvas-render.tema-editorial .render-linea { width: 80px; height: 6px; background: #c9973d; margin: 40px 0; }
    #canvas-render.tema-editorial .render-ref { font-family: 'Bebas Neue', sans-serif; font-size: 36px; color: #1a1a1a; letter-spacing: 6px; }

    /* === PLANTILLA 4: LLAMA === */
    #canvas-render.tema-llama {
      background: linear-gradient(160deg, #0d0200 0%, #5c1503 30%, #a83800 60%, #d47000 85%, #e8a820 100%);
    }
    #canvas-render.tema-llama .render-inner {
      width: 100%; height: 100%; display: flex; flex-direction: column;
      align-items: center; justify-content: center; padding: 80px; box-sizing: border-box;
      position: relative;
    }
    #canvas-render.tema-llama .render-glow {
      position: absolute; width: 500px; height: 500px; border-radius: 50%;
      background: radial-gradient(circle, rgba(255,150,50,0.25) 0%, transparent 70%);
      pointer-events: none;
    }
    #canvas-render.tema-llama .render-marca { font-family: 'Cormorant Garamond', serif; font-size: 20px; color: rgba(255,220,150,0.7); letter-spacing: 10px; text-transform: uppercase; margin-bottom: 50px; position: relative; z-index: 1; }
    #canvas-render.tema-llama .render-comilla { font-family: 'Playfair Display', serif; font-size: 160px; color: rgba(255,200,100,0.5); line-height: 0.5; margin-bottom: 20px; position: relative; z-index: 1; }
    #canvas-render.tema-llama .render-texto { font-family: 'IM Fell English', serif; font-size: 62px; color: #fff8e8; font-style: italic; line-height: 1.3; text-align: center; margin: 0; position: relative; z-index: 1; text-shadow: 0 2px 20px rgba(200,100,0,0.5); }
    #canvas-render.tema-llama .render-linea { width: 150px; height: 2px; background: linear-gradient(90deg, transparent, rgba(255,200,100,0.8), transparent); margin: 45px auto; position: relative; z-index: 1; }
    #canvas-render.tema-llama .render-ref { font-family: 'Bebas Neue', sans-serif; font-size: 34px; color: #ffd080; letter-spacing: 8px; position: relative; z-index: 1; text-shadow: 0 0 30px rgba(255,150,0,0.6); }
    #canvas-render.tema-llama .render-linea-borde { position: absolute; inset: 30px; border: 1px solid rgba(255,200,100,0.15); pointer-events: none; }

    /* === PLANTILLA 5: JARDÍN === */
    #canvas-render.tema-jardin {
      background: linear-gradient(160deg, #071510 0%, #0e2a1a 40%, #142b1c 70%, #091a10 100%);
    }
    #canvas-render.tema-jardin .render-inner {
      width: 100%; height: 100%; display: flex; flex-direction: column;
      align-items: center; justify-content: center; padding: 100px; box-sizing: border-box;
      position: relative;
    }
    #canvas-render.tema-jardin .render-borde {
      position: absolute; inset: 35px; 
      border: 1px solid rgba(100,200,130,0.2);
      pointer-events: none;
    }
    #canvas-render.tema-jardin .render-borde::before {
      content: ''; position: absolute; inset: 8px;
      border: 1px solid rgba(100,200,130,0.1);
    }
    #canvas-render.tema-jardin .corner {
      position: absolute; width: 50px; height: 50px; border-color: rgba(100,200,130,0.5);
    }
    #canvas-render.tema-jardin .corner-tl { top: 25px; left: 25px; border-top: 2px solid; border-left: 2px solid; }
    #canvas-render.tema-jardin .corner-tr { top: 25px; right: 25px; border-top: 2px solid; border-right: 2px solid; }
    #canvas-render.tema-jardin .corner-bl { bottom: 25px; left: 25px; border-bottom: 2px solid; border-left: 2px solid; }
    #canvas-render.tema-jardin .corner-br { bottom: 25px; right: 25px; border-bottom: 2px solid; border-right: 2px solid; }
    #canvas-render.tema-jardin .render-marca { font-family: 'Cormorant Garamond', serif; font-size: 20px; color: rgba(140,220,160,0.6); letter-spacing: 10px; text-transform: uppercase; margin-bottom: 50px; position: relative; z-index: 1; }
    #canvas-render.tema-jardin .render-hoja { font-size: 50px; margin-bottom: 10px; opacity: 0.6; position: relative; z-index: 1; }
    #canvas-render.tema-jardin .render-texto { font-family: 'Cormorant Garamond', serif; font-size: 60px; color: #e8f5ec; font-style: italic; font-weight: 300; line-height: 1.35; text-align: center; margin: 0; position: relative; z-index: 1; }
    #canvas-render.tema-jardin .render-linea { width: 100px; height: 1px; background: linear-gradient(90deg, transparent, rgba(140,220,160,0.7), transparent); margin: 45px auto; position: relative; z-index: 1; }
    #canvas-render.tema-jardin .render-ref { font-family: 'Playfair Display', serif; font-size: 30px; color: #90d4a0; letter-spacing: 4px; position: relative; z-index: 1; }

    /* ===== SUCCESS MODAL ===== */
    .corona { font-size: 6rem; display: block; margin-bottom: 15px; animation: bounce 2s infinite; }
    @keyframes bounce { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-25px); } }
    .btn-continuar { background: var(--primary); color: white; border: none; padding: 18px 30px; border-radius: 40px; font-weight: bold; cursor: pointer; margin-top: 25px; width: 100%; }
  </style>

  <div class="main-container">
    <div class="progress-container">
        <div class="progress-bar"><div id="progreso-valor"></div></div>
    </div>

    <header style="text-align:center; padding: 20px 0;">
      <h1 style="font-family: 'Playfair Display'; font-size: 2.5rem; color: var(--primary); margin:0;">Biblia 365</h1>
      <p id="labelDia" style="color:var(--accent); font-weight:bold; letter-spacing: 3px; margin-top:5px;">CARGANDO...</p>
    </header>

    <nav class="toolbar">
      <button class="btn-top" onclick="window.abrirBib()">📚 Biblioteca</button>
      <div style="display:flex; gap:8px;">
        <button class="btn-top" onclick="window.zoom(-2)">A-</button>
        <button class="btn-top" onclick="window.zoom(2)">A+</button>
        <button class="btn-top" onclick="window.modoNoche()">🌓</button>
      </div>
    </nav>

    <main id="contenedor-lectura" data-modo="plan"></main>

    <footer style="display:flex; gap:10px; margin: 40px 0 100px; width: 100%;">
      <button class="btn-top" style="flex:1;" onclick="window.cambiarDia(-1)">◀ Ayer</button>
      <button class="btn-top" style="flex:1; background:var(--accent);" onclick="window.irHoy()">Hoy</button>
      <button class="btn-top" style="flex:1;" onclick="window.cambiarDia(1)">Mañana ▶</button>
    </footer>
  </div>

  <!-- MODAL ÉXITO -->
  <div id="modalExito">
    <div class="box-exito">
      <span class="corona">👑</span>
      <h2 style="font-family:'Playfair Display'; color:var(--primary); font-size: 2rem; margin:0;">¡Misión Cumplida!</h2>
      <p style="color:var(--text); font-size: 1.1rem; margin: 15px 0;">Has terminado las lecturas de hoy.</p>
      <div style="background: #f0ede9; padding: 20px; border-radius: 20px; margin: 20px 0;">
        <p style="margin:0; font-weight:bold; color:var(--accent);">AVANCE TOTAL</p>
        <h3 id="txt-progreso-total" style="font-size: 2.5rem; margin:5px 0; color:var(--primary);">0%</h3>
      </div>
      <button class="btn-continuar" onclick="document.getElementById('modalExito').style.display='none'">Recibir Recompensa</button>
    </div>
  </div>

  <!-- MENÚ DE ACCIONES -->
  <div id="menuAcciones">
    <button class="btn-tool" onclick="window.resaltar()">🟡<span>Marca</span></button>
    <button class="btn-tool" onclick="window.compartir()">📤<span>Enviar</span></button>
    <button class="btn-tool" onclick="window.abrirSelectorPlantilla()" style="color:#d4a574;">✨<span>Imagen</span></button>
    <button class="btn-tool" onclick="window.cerrarMenu()">❌<span>Cerrar</span></button>
  </div>

  <!-- MODAL SELECTOR DE PLANTILLA -->
  <div id="modalPlantilla">
    <div class="plantilla-header">
      <h3>Elige tu Estilo</h3>
      <p>Selecciona una plantilla y formato</p>
    </div>

    <div class="plantillas-grid">
      <div class="plantilla-card prev-gloria seleccionada" onclick="window.elegirPlantilla('gloria', this)" data-tema="gloria">
        <div class="prev-icon">🏛️</div>
        <span>GLORIA</span>
      </div>
      <div class="plantilla-card prev-cosmos" onclick="window.elegirPlantilla('cosmos', this)" data-tema="cosmos">
        <div class="prev-icon" style="filter:drop-shadow(0 0 8px gold);">✦</div>
        <span style="color:#f0c060;">COSMOS</span>
      </div>
      <div class="plantilla-card prev-editorial" onclick="window.elegirPlantilla('editorial', this)" data-tema="editorial">
        <div class="prev-icon">📰</div>
        <span>EDITORIAL</span>
      </div>
      <div class="plantilla-card prev-llama" onclick="window.elegirPlantilla('llama', this)" data-tema="llama">
        <div class="prev-icon">🔥</div>
        <span style="color:#fde8c0;">LLAMA</span>
      </div>
      <div class="plantilla-card prev-jardin" onclick="window.elegirPlantilla('jardin', this)" data-tema="jardin">
        <div class="prev-icon">🌿</div>
        <span style="color:#90d4a0;">JARDÍN</span>
      </div>
    </div>

    <div class="formato-selector">
      <button class="btn-formato" onclick="window.generarImagen('feed')">🖼️ Feed 1:1</button>
      <button class="btn-formato" onclick="window.generarImagen('historia')">📱 Historia 9:16</button>
    </div>
    <button class="btn-cerrar-plantilla" onclick="window.cerrarSelectorPlantilla()">Cancelar</button>
  </div>

  <!-- MODAL BIBLIOTECA -->
  <div id="modalBib" onclick="if(event.target==this) window.cerrarBib()">
    <div class="modal-box" id="contenidoModal"></div>
  </div>

  <!-- CANVAS DE RENDER (invisible, fuera de pantalla) -->
  <div id="canvas-render">
    <!-- El contenido HTML se inyecta dinámicamente por JS -->
  </div>

  <script is:inline>
    const LIBROS = [
      {n:"Génesis", id:"genesis", c:50}, {n:"Éxodo", id:"exodo", c:40}, {n:"Levítico", id:"levitico", c:27},
      {n:"Números", id:"numeros", c:36}, {n:"Deuteronomio", id:"deuteronomio", c:34}, {n:"Josué", id:"josue", c:24},
      {n:"Jueces", id:"jueces", c:21}, {n:"Rut", id:"rut", c:4}, {n:"1 Samuel", id:"1-samuel", c:31},
      {n:"2 Samuel", id:"2-samuel", c:24}, {n:"1 Reyes", id:"1-reyes", c:22}, {n:"2 Reyes", id:"2-reyes", c:25},
      {n:"1 Crónicas", id:"1-cronicas", c:29}, {n:"2 Crónicas", id:"2-cronicas", c:36}, {n:"Esdras", id:"esdras", c:10},
      {n:"Nehemías", id:"nehemias", c:13}, {n:"Ester", id:"ester", c:10}, {n:"Job", id:"job", c:42},
      {n:"Salmos", id:"salmos", c:150}, {n:"Proverbios", id:"proverbios", c:31}, {n:"Eclesiastés", id:"eclesiastes", c:12},
      {n:"Cantares", id:"cantares", c:8}, {n:"Isaías", id:"isaias", c:66}, {n:"Jeremías", id:"jeremias", c:52},
      {n:"Lamentaciones", id:"lamentaciones", c:5}, {n:"Ezequiel", id:"ezequiel", c:48}, {n:"Daniel", id:"daniel", c:12},
      {n:"Oseas", id:"oseas", c:14}, {n:"Joel", id:"joel", c:3}, {n:"Amós", id:"amos", c:9},
      {n:"Abdías", id:"abdias", c:1}, {n:"Jonás", id:"jonas", c:4}, {n:"Miqueas", id:"miqueas", c:7},
      {n:"Nahúm", id:"nahum", c:3}, {n:"Habacuc", id:"habacuc", c:3}, {n:"Sofonías", id:"sofonias", c:3},
      {n:"Hageo", id:"hageo", c:2}, {n:"Zacarías", id:"zacarias", c:14}, {n:"Malaquías", id:"malaquias", c:4},
      {n:"Mateo", id:"mateo", c:28}, {n:"Marcos", id:"marcos", c:16}, {n:"Lucas", id:"lucas", c:24},
      {n:"Juan", id:"juan", c:21}, {n:"Hechos", id:"hechos", c:28}, {n:"Romanos", id:"romanos", c:16},
      {n:"1 Corintios", id:"1-corintios", c:16}, {n:"2 Corintios", id:"2-corintios", c:13}, {n:"Gálatas", id:"galatas", c:6},
      {n:"Efesios", id:"efesios", c:6}, {n:"Filipenses", id:"filipenses", c:4}, {n:"Colosenses", id:"colosenses", c:4},
      {n:"1 Tesalonicenses", id:"1-tesalonicenses", c:5}, {n:"2 Tesalonicenses", id:"2-tesalonicenses", c:3},
      {n:"1 Timoteo", id:"1-timoteo", c:6}, {n:"2 Timoteo", id:"2-timoteo", c:4}, {n:"Tito", id:"tito", c:3},
      {n:"Filemón", id:"filemon", c:1}, {n:"Hebreos", id:"hebreos", c:13}, {n:"Santiago", id:"santiago", c:5},
      {n:"1 Pedro", id:"1-pedro", c:5}, {n:"2 Pedro", id:"2-pedro", c:3}, {n:"1 Juan", id:"1-juan", c:5},
      {n:"2 Juan", id:"2-juan", c:1}, {n:"3 Juan", id:"3-juan", c:1}, {n:"Judas", id:"judas", c:1},
      {n:"Apocalipsis", id:"apocalipsis", c:22}
    ];

    let db = null, planFull = [];
    LIBROS.forEach(l => { for(let i=1; i<=l.c; i++) planFull.push({n:l.n, id:l.id, c:i}); });

    let fechaInicio = new Date(localStorage.getItem("b365_fecha_inicio") || new Date().toISOString());
    if(!localStorage.getItem("b365_fecha_inicio")) localStorage.setItem("b365_fecha_inicio", fechaInicio.toISOString());
    let fechaNav = localStorage.getItem("b365_fecha_nav") ? new Date(localStorage.getItem("b365_fecha_nav")) : new Date();

    let resaltados = JSON.parse(localStorage.getItem("b365_favs")) || {};
    let leidos = JSON.parse(localStorage.getItem("b365_leidos")) || [];
    let fontSize = parseInt(localStorage.getItem("b365_fsize")) || 21;
    let vSel = null;
    let temaActual = "gloria"; // plantilla por defecto

    // =============================================
    // GENERADOR DE HTML POR PLANTILLA
    // =============================================
    const PLANTILLA_HTML = {
      gloria: (texto, ref) => `
        <div class="render-inner">
          <div class="corner corner-tl"></div><div class="corner corner-tr"></div>
          <div class="corner corner-bl"></div><div class="corner corner-br"></div>
          <div class="render-marca">BIBLIA 365</div>
          <div class="render-comilla">"</div>
          <p class="render-texto">${texto}</p>
          <div class="render-linea"></div>
          <p class="render-ref">${ref}</p>
        </div>`,

      cosmos: (texto, ref) => `
        <div class="render-inner">
          <div class="estrellas"></div>
          <div class="nebula"></div>
          <div class="render-circulo"></div>
          <div class="render-marca">BIBLIA 365</div>
          <div class="render-comilla">"</div>
          <p class="render-texto">${texto}</p>
          <div class="render-linea"></div>
          <p class="render-ref">${ref}</p>
        </div>`,

      editorial: (texto, ref) => `
        <div class="render-inner">
          <div class="render-linea-top"></div>
          <div class="render-linea-bottom"></div>
          <div class="render-numero">❝</div>
          <div class="render-marca">BIBLIA 365</div>
          <p class="render-texto">${texto}</p>
          <div class="render-linea"></div>
          <p class="render-ref">${ref}</p>
        </div>`,

      llama: (texto, ref) => `
        <div class="render-inner">
          <div class="render-linea-borde"></div>
          <div class="render-glow"></div>
          <div class="render-marca">BIBLIA 365</div>
          <div class="render-comilla">"</div>
          <p class="render-texto">${texto}</p>
          <div class="render-linea"></div>
          <p class="render-ref">${ref}</p>
        </div>`,

      jardin: (texto, ref) => `
        <div class="render-inner">
          <div class="render-borde"></div>
          <div class="corner corner-tl"></div><div class="corner corner-tr"></div>
          <div class="corner corner-bl"></div><div class="corner corner-br"></div>
          <div class="render-hoja">✦</div>
          <div class="render-marca">BIBLIA 365</div>
          <p class="render-texto">${texto}</p>
          <div class="render-linea"></div>
          <p class="render-ref">${ref}</p>
        </div>`
    };

    // =============================================
    // SELECTOR DE PLANTILLA
    // =============================================
    window.abrirSelectorPlantilla = () => {
      document.getElementById("modalPlantilla").classList.add("visible");
    };
    window.cerrarSelectorPlantilla = () => {
      document.getElementById("modalPlantilla").classList.remove("visible");
    };
    window.elegirPlantilla = (tema, card) => {
      temaActual = tema;
      document.querySelectorAll(".plantilla-card").forEach(c => c.classList.remove("seleccionada"));
      card.classList.add("seleccionada");
    };

    // =============================================
    // GENERADOR DE IMAGEN
    // =============================================
    const BG_TEMAS = {
      gloria: "#fdf6e3", cosmos: "#020818",
      editorial: "#f5f0e8", llama: "#3a0a00", jardin: "#071510"
    };

    window.generarImagen = async (tipo) => {
      window.cerrarSelectorPlantilla();

      const t = document.getElementById("canvas-render");
      const w = tipo === "feed" ? 1080 : 1080;
      const h = tipo === "feed" ? 1080 : 1920;

      // Configurar tamaño y clases
      t.style.width  = w + "px";
      t.style.height = h + "px";
      t.className = "";
      t.classList.add("tema-" + temaActual);
      t.classList.add(tipo === "feed" ? "formato-feed" : "formato-historia");

      // Inyectar HTML de la plantilla
      t.innerHTML = PLANTILLA_HTML[temaActual](vSel.texto, vSel.ref);

      // Mostrar brevemente para que el navegador lo renderice
      t.style.visibility = "visible";
      t.style.zIndex = "9999";

      // Esperar fonts + layout
      await document.fonts.ready;
      await new Promise(r => setTimeout(r, 400));

      try {
        const canvas = await html2canvas(t, {
          scale: 2,
          useCORS: true,
          allowTaint: true,
          backgroundColor: BG_TEMAS[temaActual],
          width: w,
          height: h,
          windowWidth: w,
          windowHeight: h,
          logging: false,
          imageTimeout: 0
        });

        // Ocultar de nuevo
        t.style.visibility = "hidden";
        t.style.zIndex = "-1";

        // Descargar imagen
        const a = document.createElement("a");
        a.download = "Biblia365-" + temaActual + "-" + vSel.ref.replace(/[: ]/g, "-") + ".png";
        a.href = canvas.toDataURL("image/png", 1.0);
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);

      } catch(err) {
        console.error("Error generando imagen:", err);
        t.style.visibility = "hidden";
        t.style.zIndex = "-1";
        alert("Error al generar la imagen. Intenta de nuevo.");
      }
    };

    // =============================================
    // LÓGICA PRINCIPAL (sin cambios)
    // =============================================
    async function iniciar() {
      try {
        const res = await fetch("/biblia.json");
        db = await res.json();
        renderPlan();
      } catch(e) { console.error("Error cargando Biblia", e); }
    }

    function renderPlan() {
      const diffTime = Math.abs(fechaNav - fechaInicio);
      const diaMision = Math.floor(diffTime / (1000 * 60 * 60 * 24)) + 1;
      const label = document.getElementById("labelDia");
      if(label) label.innerText = "DÍA " + diaMision;
      const cont = document.getElementById("contenedor-lectura");
      if(cont) cont.dataset.modo = "plan";
      const promedio = planFull.length / 365; 
      const inicioIndex = Math.floor((diaMision - 1) * promedio);
      const finIndex = Math.floor(diaMision * promedio);
      dibujarLectura(planFull.slice(inicioIndex, finIndex));
      actualizarProgreso();
      localStorage.setItem("b365_fecha_nav", fechaNav.toISOString());
    }

    function dibujarLectura(items) {
      let html = "";
      items.forEach((it, idx) => {
        const cap = (db && db[it.id]) ? db[it.id][it.c] : null;
        if(cap) {
          html += '<div class="acordeon-item ' + (idx == 0 ? "active" : "") + '" id="ac-' + idx + '">';
          html += '<div class="acordeon-header" onclick="window.toggleAc(' + idx + ')">';
          html += '<h2>' + it.n + ' ' + it.c + '</h2><span>▼</span></div>';
          html += '<div class="acordeon-content">';
          Object.entries(cap).forEach(([n, t]) => {
            const ref = it.n + " " + it.c + ":" + n;
            const isFav = resaltados[ref] ? 'style="background:#fef08a; color:#000;"' : "";
            const isRead = leidos.includes(ref) ? "read" : "";
            html += '<span class="v-txt ' + isRead + '" ' + isFav + ' onclick="window.seleccionarV(this, \'' + ref + '\')">';
            html += '<span class="v-num">' + n + '</span>' + t.replace(/^\d+\/n/, "").replace(/\/n/g, "<br>");
            html += '</span>';
          });
          html += '</div></div>';
        }
      });
      const cont = document.getElementById("contenedor-lectura");
      if(cont) cont.innerHTML = html;
    }

    window.toggleAc = (i) => {
      const items = document.querySelectorAll(".acordeon-item");
      const wasActive = items[i].classList.contains("active");
      items.forEach(el => el.classList.remove("active"));
      if (!wasActive) items[i].classList.add("active");
    };

    window.seleccionarV = (el, ref) => {
      vSel = { el: el, texto: el.innerText.replace(/^\d+/, "").trim(), ref: ref };
      document.getElementById("menuAcciones").style.display = "flex";
      if(!leidos.includes(ref)) {
          leidos.push(ref);
          el.classList.add("read");
          localStorage.setItem("b365_leidos", JSON.stringify(leidos));
          actualizarProgreso();
      }
    };

    function actualizarProgreso() {
      const totalHoy = document.querySelectorAll(".v-txt").length;
      const leidosHoy = document.querySelectorAll(".v-txt.read").length;
      if(totalHoy > 0) {
        const porc = (leidosHoy / totalHoy * 100);
        const barra = document.getElementById("progreso-valor");
        if(barra) barra.style.width = porc + "%";
        const cont = document.getElementById("contenedor-lectura");
        const label = document.getElementById("labelDia");
        if (porc === 100 && cont && cont.dataset.modo === "plan" && !sessionStorage.getItem("fec_" + label.innerText)) {
          const totalTxt = document.getElementById("txt-progreso-total");
          if(totalTxt) totalTxt.innerText = ((leidos.length / 31102) * 100).toFixed(2) + "%";
          document.getElementById("modalExito").style.display = "grid";
          sessionStorage.setItem("fec_" + label.innerText, "true");
        }
      }
    }

    window.abrirBib = () => {
      const m = document.getElementById("contenidoModal");
      let html = '<h2 style="text-align:center;">Biblioteca</h2>';
      html += '<button class="btn-lib" style="width:100%; margin-bottom:20px; background:var(--accent); color:white;" onclick="window.reiniciarPlan()">Reiniciar al Día 1</button>';
      html += '<div class="grid-libros">' + LIBROS.map(l => '<button class="btn-lib" onclick="window.verCaps(\''+l.id+'\', \''+l.n+'\', '+l.c+')">'+l.n+'</button>').join("") + '</div>';
      if(m) m.innerHTML = html;
      document.getElementById("modalBib").style.display = "grid";
    };

    window.verCaps = (id, n, total) => {
      let c = "";
      for(let i=1; i<=total; i++) c += '<button class="btn-lib" onclick="window.irACap(\''+id+'\',\''+n+'\','+i+')">'+i+'</button>';
      const m = document.getElementById("contenidoModal");
      if(m) m.innerHTML = '<button onclick="window.abrirBib()" style="background:none; border:none; color:var(--accent); cursor:pointer;">◀ Volver</button><h2 style="text-align:center;">'+n+'</h2><div class="grid-caps">'+c+'</div>';
    };

    window.irACap = (id, n, c) => {
      window.cerrarBib();
      const cont = document.getElementById("contenedor-lectura");
      if(cont) cont.dataset.modo = "libre"; 
      dibujarLectura([{id:id, n:n, c:c}]);
      window.scrollTo(0,0);
    };

    window.cambiarDia = (n) => { fechaNav.setDate(fechaNav.getDate()+n); renderPlan(); window.scrollTo(0,0); };
    window.irHoy = () => { fechaNav = new Date(); renderPlan(); window.scrollTo(0,0); };
    window.cerrarBib = () => document.getElementById("modalBib").style.display = "none";
    window.cerrarMenu = () => document.getElementById("menuAcciones").style.display = "none";
    window.modoNoche = () => document.body.classList.toggle("dark-mode");
    window.zoom = (n) => { fontSize += n; document.documentElement.style.setProperty("--f-size", fontSize+"px"); };
    window.resaltar = () => { if(resaltados[vSel.ref]) delete resaltados[vSel.ref]; else resaltados[vSel.ref]=true; localStorage.setItem("b365_favs", JSON.stringify(resaltados)); renderPlan(); window.cerrarMenu(); };
    window.compartir = async () => { await navigator.share({title:"Biblia 365", text:'"' + vSel.texto + '" (' + vSel.ref + ')'}); window.cerrarMenu(); };
    window.reiniciarPlan = () => { if(confirm("¿Día 1?")) { localStorage.setItem("b365_fecha_inicio", new Date().toISOString()); location.reload(); } };

    document.addEventListener("DOMContentLoaded", iniciar);
  </script>
</PageLayout>
