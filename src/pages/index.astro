---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Mi Amigo Anhelado | Un Encuentro con la Verdad que Transforma">
  <section class="hero">
    <div class="hero-glow"></div>

    <div class="hero-content">
      <span class="fade-in subtitle">UN ESPACIO PARA EL ALMA</span>

      <h1 class="fade-in title">
        Mi Amigo Anhelado
      </h1>

      <p class="fade-in description">
        En medio del ruido del mundo, existe una Voz que no grita…
        <br class="desktop-only"/>
        pero transforma para siempre al que decide escucharla.
      </p>

      <div class="mana-diario fade-in">
        <div class="mana-content">
          <span class="mana-badge">Palabra Viva</span>
          <p id="versiculo-texto">
            "Venid a mí todos los que estáis trabajados y cargados..."
          </p>
          <small id="versiculo-cita">— Mateo 11:28</small>
        </div>
      </div>

      <div class="hero-actions fade-in">
        <a href="/app-biblia" class="btn-primary">
          📖 Iniciar Recorrido
        </a>

        <a href="/vivencias" class="btn-secondary">
          ✨ Explorar Personajes
        </a>
      </div>

      <div class="scroll-indicator">
        <span></span>
      </div>
    </div>
  </section>

  <!-- SECCIÓN PROPÓSITO -->
  <section class="purpose">
    <div class="purpose-content">
      <h2>Esto no es contenido. Es dirección.</h2>
      <p>
        Mi Amigo Anhelado nace para quienes están cansados de respuestas superficiales.
        Aquí no buscamos entretenerte, buscamos despertarte.
        No imponemos religión; proponemos encuentro.
      </p>
      <p>
        Cada palabra, cada lectura, cada pausa,
        está pensada para llevarte a una transformación silenciosa pero real.
      </p>
    </div>
  </section>

  <!-- EXPERIENCIA -->
  <section class="experience">
    <div class="experience-grid">
      <div class="exp-card">
        <h3>Lectura Profunda</h3>
        <p>
          Interfaz limpia, tipografía contemplativa y ritmo visual pensado
          para que tu mente desacelere.
        </p>
      </div>

      <div class="exp-card">
        <h3>Silencio Digital</h3>
        <p>
          Sin anuncios invasivos.
          Sin distracciones innecesarias.
          Solo tú y la Palabra.
        </p>
      </div>

      <div class="exp-card">
        <h3>Proceso de 365 Días</h3>
        <p>
          Un recorrido estructurado para formar disciplina espiritual,
          no solo emoción momentánea.
        </p>
      </div>
    </div>
  </section>

  <!-- LLAMADO FINAL -->
  <section class="cta-final">
    <h2>Si has llegado hasta aquí… no es casualidad.</h2>
    <a href="/app-biblia" class="btn-primary large">
      Comenzar Ahora
    </a>
  </section>

  <style>
    :root {
      --primary: #173d2a;
      --accent: #d4a574;
      --bg: #fdfaf6;
      --text-soft: #5d6d7e;
      --max-width: 1200px;
    }

    body {
      background: var(--bg);
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      padding: 2rem;
      overflow: hidden;
    }

    .hero-glow {
      position: absolute;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(212,165,116,0.15) 0%, transparent 70%);
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      animation: pulse 8s infinite ease-in-out;
    }

    @keyframes pulse {
      0%,100% { transform: translate(-50%, -50%) scale(1); }
      50% { transform: translate(-50%, -50%) scale(1.08); }
    }

    .hero-content {
      max-width: 850px;
      position: relative;
      z-index: 2;
    }

    .subtitle {
      letter-spacing: 6px;
      font-size: 0.8rem;
      color: var(--accent);
      margin-bottom: 1.5rem;
      font-weight: bold;
    }

    .title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(3rem, 8vw, 5.5rem);
      color: var(--primary);
      margin-bottom: 1.5rem;
      line-height: 1;
    }

    .description {
      font-size: 1.3rem;
      color: var(--text-soft);
      margin-bottom: 3rem;
      line-height: 1.8;
    }

    /* MANA */
    .mana-diario {
      margin: 0 auto 3rem;
      padding: 2.5rem;
      max-width: 550px;
      background: rgba(255,255,255,0.8);
      backdrop-filter: blur(15px);
      border-radius: 30px;
      border: 1px solid rgba(212,165,116,0.3);
      box-shadow: 0 30px 60px rgba(0,0,0,0.05);
      transition: opacity 1s ease;
    }

    .mana-badge {
      display: inline-block;
      margin-bottom: 1rem;
      font-size: 0.75rem;
      letter-spacing: 2px;
      color: var(--accent);
      font-weight: bold;
    }

    .mana-content p {
      font-size: 1.6rem;
      font-family: 'Crimson Text', serif;
      font-style: italic;
      color: var(--primary);
      line-height: 1.5;
    }

    .mana-content small {
      display: block;
      margin-top: 0.8rem;
      color: var(--accent);
      font-weight: bold;
    }

    /* BOTONES */
    .btn-primary, .btn-secondary {
      padding: 1.2rem 2.5rem;
      border-radius: 50px;
      font-weight: bold;
      text-decoration: none;
      transition: all 0.3s ease;
      display: inline-block;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
      box-shadow: 0 15px 35px rgba(23,61,42,0.3);
    }

    .btn-primary:hover {
      transform: translateY(-4px);
      background: #1f5337;
    }

    .btn-secondary {
      border: 2px solid var(--primary);
      color: var(--primary);
      margin-left: 1rem;
    }

    .btn-secondary:hover {
      background: var(--primary);
      color: white;
    }

    .large {
      padding: 1.5rem 3.5rem;
      font-size: 1.1rem;
    }

    /* PURPOSE */
    .purpose {
      padding: 7rem 2rem;
      text-align: center;
      max-width: 800px;
      margin: auto;
    }

    .purpose h2 {
      font-family: 'Playfair Display', serif;
      font-size: 2.5rem;
      color: var(--primary);
      margin-bottom: 2rem;
    }

    .purpose p {
      font-size: 1.2rem;
      color: var(--text-soft);
      line-height: 1.9;
      margin-bottom: 1.5rem;
    }

    /* EXPERIENCE */
    .experience {
      padding: 6rem 2rem;
      background: white;
    }

    .experience-grid {
      max-width: var(--max-width);
      margin: auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px,1fr));
      gap: 3rem;
    }

    .exp-card {
      padding: 2rem;
      border-radius: 20px;
      background: var(--bg);
      transition: 0.3s;
    }

    .exp-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 15px 40px rgba(0,0,0,0.05);
    }

    .exp-card h3 {
      font-family: 'Playfair Display', serif;
      color: var(--primary);
      margin-bottom: 1rem;
    }

    .exp-card p {
      color: var(--text-soft);
      line-height: 1.7;
    }

    /* CTA FINAL */
    .cta-final {
      padding: 7rem 2rem;
      text-align: center;
      background: var(--primary);
      color: white;
    }

    .cta-final h2 {
      font-family: 'Playfair Display', serif;
      margin-bottom: 2rem;
      font-size: 2.3rem;
    }

    .cta-final .btn-primary {
      background: white;
      color: var(--primary);
      box-shadow: none;
    }

    .cta-final .btn-primary:hover {
      background: var(--accent);
      color: white;
    }

    /* SCROLL INDICATOR */
    .scroll-indicator {
      margin-top: 4rem;
    }

    .scroll-indicator span {
      display: block;
      width: 2px;
      height: 40px;
      background: var(--accent);
      margin: auto;
      animation: scroll 2s infinite;
    }

    @keyframes scroll {
      0% { opacity: 0; transform: translateY(-10px); }
      50% { opacity: 1; }
      100% { opacity: 0; transform: translateY(10px); }
    }

    @media (max-width: 768px) {
      .btn-secondary {
        display: block;
        margin: 1rem 0 0 0;
      }
    }
  </style>

  <script is:inline>
    const versiculos = [
      { texto: "Yo soy el camino, y la verdad, y la vida.", cita: "Juan 14:6" },
      { texto: "La paz os dejo, mi paz os doy.", cita: "Juan 14:27" },
      { texto: "Si permanecéis en mi palabra, seréis verdaderamente mis discípulos.", cita: "Juan 8:31" },
      { texto: "Venid a mí todos los que estáis trabajados y cargados.", cita: "Mateo 11:28" }
    ];

    function cargarVersiculo() {
      const indice = Math.floor(Math.random() * versiculos.length);
      document.getElementById('versiculo-texto').innerText =
        `"${versiculos[indice].texto}"`;
      document.getElementById('versiculo-cita').innerText =
        `— ${versiculos[indice].cita}`;
    }

    document.addEventListener('DOMContentLoaded', cargarVersiculo);
  </script>
</PageLayout>
