---
import PageLayout from '../layouts/PageLayout.astro';
---

<PageLayout title="Mi Amigo Anhelado | Un Encuentro que Transforma">

  <!-- BARRA PROGRESO ESPIRITUAL -->
  <div class="progress-bar"></div>

  <section class="hero">
    <div class="hero-glow"></div>

    <div class="hero-content reveal">
      <span class="subtitle">UN ESPACIO PARA EL ALMA</span>

      <h1 class="title">
        Mi Amigo Anhelado
      </h1>

      <p class="description">
        Cuando el mundo grita, Dios susurra.
        <br class="desktop-only"/>
        Y quien aprende a escuchar, jamás vuelve a ser el mismo.
      </p>

      <div class="mana-diario">
        <div class="mana-content">
          <span class="mana-badge">Palabra Viva</span>
          <p id="versiculo-texto">
            "Yo soy el camino, y la verdad, y la vida."
          </p>
          <small id="versiculo-cita">— Juan 14:6</small>
        </div>
      </div>

      <div class="hero-actions">
        <a href="/app-biblia" class="btn-primary">
          📖 Iniciar Recorrido
        </a>
        <a href="/vivencias" class="btn-secondary">
          ✨ Explorar
        </a>
      </div>
    </div>
  </section>

  <!-- PROPÓSITO -->
  <section class="section reveal">
    <h2>Esto no es información. Es transformación.</h2>
    <p>
      Este espacio fue creado para quienes sienten que hay algo más profundo
      que la rutina, más real que la religión superficial y más eterno que las tendencias.
    </p>
  </section>

  <!-- EXPERIENCIA -->
  <section class="experience">
    <div class="exp-card reveal">
      <h3>Silencio Digital</h3>
      <p>Sin distracciones. Sin ruido comercial. Solo presencia.</p>
    </div>

    <div class="exp-card reveal">
      <h3>Ritmo Contemplativo</h3>
      <p>Tipografía, espacios y transiciones pensadas para desacelerar tu mente.</p>
    </div>

    <div class="exp-card reveal">
      <h3>Proceso de 365 Días</h3>
      <p>Una disciplina espiritual progresiva y visible.</p>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="cta reveal">
    <h2>Si estás aquí… no es casualidad.</h2>
    <a href="/app-biblia" class="btn-primary large">
      Comenzar Ahora
    </a>
  </section>

  <style>
    :root {
      --primary: #173d2a;
      --accent: #d4a574;
      --bg-light: #fdfaf6;
      --bg-dark: #0f1c16;
      --text-light: #5d6d7e;
      --text-dark: #cfd8d3;
    }

    body {
      background: var(--bg-light);
      transition: background 0.6s ease, color 0.6s ease;
    }

    body.dark {
      background: var(--bg-dark);
      color: var(--text-dark);
    }

    /* PROGRESS BAR */
    .progress-bar {
      position: fixed;
      top: 0;
      left: 0;
      height: 3px;
      background: var(--accent);
      width: 0%;
      z-index: 9999;
      transition: width 0.2s ease;
    }

    /* HERO */
    .hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      position: relative;
      overflow: hidden;
    }

    .hero-glow {
      position: absolute;
      width: 600px;
      height: 600px;
      background: radial-gradient(circle, rgba(212,165,116,0.15) 0%, transparent 70%);
      animation: pulse 8s infinite ease-in-out;
    }

    @keyframes pulse {
      0%,100% { transform: scale(1); }
      50% { transform: scale(1.1); }
    }

    .title {
      font-family: 'Playfair Display', serif;
      font-size: clamp(3rem, 8vw, 5.5rem);
      color: var(--primary);
    }

    body.dark .title {
      color: white;
    }

    .description {
      font-size: 1.3rem;
      margin: 1.5rem 0 3rem;
      color: var(--text-light);
    }

    body.dark .description {
      color: var(--text-dark);
    }

    /* MANA */
    .mana-diario {
      padding: 2.5rem;
      max-width: 550px;
      margin: 0 auto 3rem;
      border-radius: 25px;
      backdrop-filter: blur(15px);
      background: rgba(255,255,255,0.7);
      transition: 0.5s ease;
    }

    body.dark .mana-diario {
      background: rgba(255,255,255,0.05);
    }

    .mana-content p {
      font-family: 'Crimson Text', serif;
      font-style: italic;
      font-size: 1.6rem;
    }

    /* BUTTONS */
    .btn-primary, .btn-secondary {
      padding: 1.2rem 2.5rem;
      border-radius: 50px;
      font-weight: bold;
      text-decoration: none;
      transition: 0.3s ease;
      display: inline-block;
    }

    .btn-primary {
      background: var(--primary);
      color: white;
    }

    .btn-primary:hover {
      transform: translateY(-4px);
    }

    .btn-secondary {
      border: 2px solid var(--primary);
      color: var(--primary);
      margin-left: 1rem;
    }

    /* SECTIONS */
    .section, .cta {
      padding: 7rem 2rem;
      text-align: center;
      max-width: 800px;
      margin: auto;
    }

    .experience {
      padding: 6rem 2rem;
      display: grid;
      gap: 3rem;
      max-width: 1100px;
      margin: auto;
    }

    .exp-card {
      padding: 2rem;
      border-radius: 20px;
      background: var(--bg-light);
      transition: 0.4s ease;
    }

    body.dark .exp-card {
      background: rgba(255,255,255,0.05);
    }

    .exp-card:hover {
      transform: translateY(-6px);
    }

    /* REVEAL ANIMATION */
    .reveal {
      opacity: 0;
      transform: translateY(40px);
      transition: 1s ease;
    }

    .reveal.active {
      opacity: 1;
      transform: translateY(0);
    }
  </style>

  <script is:inline>
    // Versículos dinámicos
    const versiculos = [
      { texto: "Yo soy el camino, y la verdad, y la vida.", cita: "Juan 14:6" },
      { texto: "La paz os dejo, mi paz os doy.", cita: "Juan 14:27" },
      { texto: "Venid a mí todos los que estáis trabajados y cargados.", cita: "Mateo 11:28" }
    ];

    function cargarVersiculo() {
      const i = Math.floor(Math.random() * versiculos.length);
      document.getElementById("versiculo-texto").innerText =
        `"${versiculos[i].texto}"`;
      document.getElementById("versiculo-cita").innerText =
        `— ${versiculos[i].cita}`;
    }

    document.addEventListener("DOMContentLoaded", cargarVersiculo);

    // Scroll progress bar
    window.addEventListener("scroll", () => {
      const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
      const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
      const scrolled = (winScroll / height) * 100;
      document.querySelector(".progress-bar").style.width = scrolled + "%";
    });

    // Reveal animation
    const reveals = document.querySelectorAll(".reveal");
    window.addEventListener("scroll", () => {
      reveals.forEach(el => {
        const windowHeight = window.innerHeight;
        const elementTop = el.getBoundingClientRect().top;
        if (elementTop < windowHeight - 100) {
          el.classList.add("active");
        }
      });
    });

    // Auto Dark Mode
    if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
      document.body.classList.add('dark');
    }
  </script>

</PageLayout>
